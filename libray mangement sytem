-- =========================
-- QUERIES
-- =========================

-- 1. Display all members
SELECT * FROM Members;

-- 2. Display all books
SELECT * FROM Books;

-- 3. Display books with author names
SELECT 
    Books.BookID,
    Books.Title,
    Authors.AuthorName,
    Books.Category
FROM Books
JOIN Authors 
ON Books.AuthorID = Authors.AuthorID;

-- 4. Display issued book details
SELECT 
    IssueBook.IssueID,
    Members.FullName,
    Books.Title,
    IssueBook.IssueDate,
    IssueBook.DueDate,
    IssueBook.ReturnDate
FROM IssueBook
JOIN Members 
ON IssueBook.MemberID = Members.MemberID
JOIN Books 
ON IssueBook.BookID = Books.BookID;

-- 5. Display currently issued books
SELECT 
    Members.FullName,
    Books.Title,
    IssueBook.DueDate
FROM IssueBook
JOIN Members 
ON IssueBook.MemberID = Members.MemberID
JOIN Books 
ON IssueBook.BookID = Books.BookID
WHERE IssueBook.ReturnDate IS NULL;

-- 6. Count total books
SELECT COUNT(*) AS TotalBooks
FROM Books;

-- 7. Count total members
SELECT COUNT(*) AS TotalMembers
FROM Members;

-- 8. Display book titles and available copies
SELECT 
    Title,
    CopiesAvailable
FROM Books;

-- 9. Calculate total fine
SELECT 
    SUM(FineAmount) AS TotalFine
FROM Fine;
